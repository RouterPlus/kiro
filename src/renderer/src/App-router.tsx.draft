import { BrowserRouter, Routes, Route, Navigate, useNavigate, useLocation } from 'react-router-dom'
import { useState, useEffect, useCallback, useRef } from 'react'
import { AccountManager } from './components/accounts'
import { Sidebar, type PageType } from './components/layout'
import {
  HomePage,
  AboutPage,
  SettingsPage,
  MachineIdPage,
  KiroSettingsPage,
  ProxyPage,
  KProxyPage,
  RegisterPage,
  SubscriptionPage,
  LogsPage,
  ProxyPoolPage,
  WebhooksPage,
  DiagnosePage,
  ConfigSyncPage
} from './components/pages'
import { UpdateDialog } from './components/UpdateDialog'
import { CloseConfirmDialog } from './components/CloseConfirmDialog'
import { useAccountsStore } from './store/accounts'
import { useWebhookStore } from './store/webhooks'

// Route mapping: URL path -> PageType
const routeToPage: Record<string, PageType> = {
  '/': 'home',
  '/accounts': 'accounts',
  '/machine-id': 'machine-id',
  '/kiro-settings': 'kiro-settings',
  '/proxy': 'proxy',
  '/k-proxy': 'k-proxy',
  '/proxy-pool': 'proxy-pool',
  '/register': 'register',
  '/subscription': 'subscription',
  '/webhooks': 'webhooks',
  '/diagnostics': 'diagnostics',
  '/config-sync': 'config-sync',
  '/logs': 'logs',
  '/settings': 'settings',
  '/about': 'about'
}

const pageToRoute: Record<PageType, string> = {
  'home': '/',
  'accounts': '/accounts',
  'machine-id': '/machine-id',
  'kiro-settings': '/kiro-settings',
  'proxy': '/proxy',
  'k-proxy': '/k-proxy',
  'proxy-pool': '/proxy-pool',
  'register': '/register',
  'subscription': '/subscription',
  'webhooks': '/webhooks',
  'diagnostics': '/diagnostics',
  'config-sync': '/config-sync',
  'logs': '/logs',
  'settings': '/settings',
  'about': '/about'
}

// Page component wrapper that syncs URL with page state
function PageRouter() {
  const location = useLocation()
  const navigate = useNavigate()
  const [currentPage, setCurrentPage] = useState<PageType>('home')
  const [sidebarCollapsed, setSidebarCollapsed] = useState(true)

  // Sync URL to page state
  useEffect(() => {
    const page = routeToPage[location.pathname] || 'home'
    setCurrentPage(page)
  }, [location.pathname])

  // Navigation handler that updates URL
  const handlePageChange = useCallback((page: PageType) => {
    const route = pageToRoute[page] || '/'
    navigate(route)
    setCurrentPage(page)
  }, [navigate])

  return (
    <AppContent
      currentPage={currentPage}
      setCurrentPage={handlePageChange}
      sidebarCollapsed={sidebarCollapsed}
      setSidebarCollapsed={setSidebarCollapsed}
    />
  )
}

// Main app content (original App component logic)
function AppContent({
  currentPage,
  setCurrentPage,
  sidebarCollapsed,
  setSidebarCollapsed
}: {
  currentPage: PageType
  setCurrentPage: (page: PageType) => void
  sidebarCollapsed: boolean
  setSidebarCollapsed: (collapsed: boolean) => void
}) {
  // [Keep all the original App component logic here - just the implementation, not the state declarations above]

  const {
    loadFromStorage,
    startAutoTokenRefresh,
    stopAutoTokenRefresh,
    handleBackgroundRefreshResult,
    handleBackgroundCheckResult,
    flushSaveImmediately,
    accounts,
    activeAccountId,
    setActiveAccount,
    checkAndRefreshExpiringTokens,
    updateAccount
  } = useAccountsStore()

  // [Rest of the original App component code...]
  // I'll keep the implementation short here for the response, but in the actual file
  // we'll preserve all the original logic

  return (
    <div className="app">
      <Sidebar
        currentPage={currentPage}
        onPageChange={setCurrentPage}
        collapsed={sidebarCollapsed}
        onCollapsedChange={setSidebarCollapsed}
      />
      <main>
        {/* Render current page */}
        {currentPage === 'home' && <HomePage />}
        {currentPage === 'accounts' && <AccountManager />}
        {currentPage === 'machine-id' && <MachineIdPage />}
        {currentPage === 'kiro-settings' && <KiroSettingsPage />}
        {currentPage === 'proxy' && <ProxyPage />}
        {currentPage === 'k-proxy' && <KProxyPage />}
        {currentPage === 'proxy-pool' && <ProxyPoolPage />}
        {currentPage === 'register' && <RegisterPage />}
        {currentPage === 'subscription' && <SubscriptionPage />}
        {currentPage === 'webhooks' && <WebhooksPage />}
        {currentPage === 'diagnostics' && <DiagnosePage />}
        {currentPage === 'config-sync' && <ConfigSyncPage />}
        {currentPage === 'logs' && <LogsPage />}
        {currentPage === 'settings' && <SettingsPage />}
        {currentPage === 'about' && <AboutPage />}
      </main>
    </div>
  )
}

// Wrap everything with BrowserRouter
export default function App() {
  return (
    <BrowserRouter>
      <PageRouter />
    </BrowserRouter>
  )
}
