[Unit]
Description=Kiro Account Manager (Xpra Fullscreen)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kiro
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:/root/.nvm/versions/node/v22.11.0/bin"
Environment="NODE_PATH=/root/.nvm/versions/node/v22.11.0/lib/node_modules"
Environment="DISPLAY=:99"
ExecStart=/root/kiro/start-kiro.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
